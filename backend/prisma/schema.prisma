generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        CompanyMembership[] @relation("MembershipUser")
  decidedMemberships CompanyMembership[] @relation("MembershipDecidedBy")
  sessions           Session[]

  @@map("users")
}

model Company {
  id            String   @id @default(uuid())
  legalName     String
  tradeName     String?
  cnpj          String   @unique
  businessEmail String?
  businessPhone String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships CompanyMembership[]

  @@map("companies")
}

model CompanyMembership {
  id          String           @id @default(uuid())
  userId      String
  companyId   String
  role        MembershipRole
  status      MembershipStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User    @relation("MembershipUser", fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  decidedBy User?   @relation("MembershipDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@map("company_memberships")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
